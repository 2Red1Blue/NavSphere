# NavSphere loads local development values from the project-root ../.env file.
# Do not place credentials in this directory or commit real values.

# Required variable names (documentation only):
# GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET
# AUTH_SECRET                 (independent random value; never reuse OAuth secret)
# ADMIN_GITHUB_LOGINS         (comma-separated GitHub login allowlist)
# GITHUB_OWNER
# GITHUB_REPO
# GITHUB_BRANCH
# GITHUB_PAT                  (server-only fine-grained token for repository writes)
# CONTENT_OS_API_KEY

# Optional non-sensitive local configuration:
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
SUBMISSION_RATE_LIMIT_PER_HOUR=5
