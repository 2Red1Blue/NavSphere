{
  "name": "navsphere",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src tests scripts/navigation-tree.test.ts",
    "test": "pnpm run test:unit && pnpm run test:schema",
    "test:unit": "tsx --test tests/*.test.ts scripts/navigation-tree.test.ts",
    "test:schema": "sh scripts/verify-d1-schema.sh",
    "clean": "rm -rf .next",
    "docker:build": "docker build -f docker/Dockerfile -t navsphere:latest .",
    "docker:dev": "docker compose --env-file ../.env -f docker/docker-compose.yml up -d",
    "docker:prod": "docker compose --env-file ../.env -f docker/docker-compose.prod.yml up -d",
    "docker:stop": "docker compose --env-file ../.env -f docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file ../.env -f docker/docker-compose.yml logs -f",
    "docker:deploy": "./scripts/docker-deploy.sh",
    "cf:build": "next-on-pages",
    "cf:migrations:list": "wrangler d1 migrations list content-os-feed --remote",
    "cf:migrate": "wrangler d1 migrations apply content-os-feed --remote",
    "cf:deploy": "pnpm run cf:build && wrangler pages deploy .vercel/output/static --project-name navsphere"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
